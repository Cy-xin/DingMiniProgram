.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #a8e0ff 0%, #8ee2f5 35%, #92d8f8 65%, #a1c4fd 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx; /* 避免底部栏遮挡内容 */
}

.cart-list {
  flex: 1;
  padding: 24rpx;
}

/* 商品网格 */
.multi-row-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
}

.vertical-card {
  background: #ffffff45;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.08);
  overflow: hidden;
  transition: all 0.3s ease;
}

.vertical-card:active {
  transform: scale(0.97);
}

.card-content {
  display: flex;
  padding: 24rpx;
  gap: 140rpx;
}

.product-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  border: 2rpx solid #fff;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-text {
  color: #e4393c;
  font-size: 32rpx;
  font-weight: bold;
}

/* 数量选择器玻璃化 */
.quantity-picker {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.6);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
  gap: 20rpx;
  backdrop-filter: blur(10rpx);
}

.btn-quantity {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  color: #409EFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(64,158,255,0.25);
  transition: all 0.2s ease;
}

.btn-quantity:active {
  transform: scale(0.9);
  background: #409EFF;
  color: #fff;
}

.quantity-value {
  min-width: 60rpx;
  color: #333;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* 底部栏 */
.cart-footer {
  position: fixed;
  bottom: 210rpx; /* 🔥 紧贴 tabbar 上方 */
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 40rpx; /* 🔥 圆角调小，避免和tabbar重复 */
  padding: 0 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 14rpx rgba(0,0,0,0.1);
  z-index: 200;
}

.footer-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.total-label {
  font-size: 28rpx;
  color: #444;
}

.total-price {
  font-size: 44rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.footer-buttons {
  display: flex;
  gap: 20rpx;
}

.clear-btn {
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(0,0,0,0.1);
  color: #666;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.clear-btn:active {
  background: rgba(240,240,240,0.9);
  transform: scale(0.95);
}

.checkout-btn {
  background: linear-gradient(135deg, #36d1dc, #5b86e5); /* 🔥 改成渐变，更突出 */
  color: #fff;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(91,134,229,0.35);
}

.checkout-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(64,158,255,0.4);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.go-shopping-btn {
  background: #409eff;
  color: #fff;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}