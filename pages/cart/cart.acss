.container {
  min-height: 100vh;
    /* 核心改动：设置一个多彩的渐变背景，这是玻璃效果的基础 */
  background: linear-gradient(135deg, #a8e0ff 0%, #8ee2f5 35%, #92d8f8 65%, #a1c4fd 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

.cart-list {
  flex: 1;
  padding: 24rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 20rpx;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.product-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.product-body {
  padding: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 100%;
}

.product-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.price-text {
  color: #e4393c;
  font-size: 32rpx;
  font-weight: bold;
}

.quantity-picker {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 8rpx 16rpx;
  gap: 16rpx;
}

.btn-quantity {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  color: #409EFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(64, 158, 255, 0.2);
  transition: all 0.2s ease;
}

.btn-quantity:active {
  transform: scale(0.9);
  background: #409EFF;
  color: #fff;
}

.quantity-value {
  min-width: 60rpx;
  color: #333;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.footer-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #e4393c;
  font-weight: bold;
}

.footer-buttons {
  display: flex;
  gap: 16rpx;
}

.clear-btn, .checkout-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.clear-btn {
  background: #f5f7fa;
  color: #666;
}

.checkout-btn {
  background: #409eff;
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.go-shopping-btn {
  background: #409eff;
  color: #fff;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

/* 替换横向滚动样式 */
.multi-row-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
}

.vertical-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  overflow: hidden;
  transition: all 0.3s ease;
}

.vertical-card:active {
  transform: scale(0.98);
}

.card-content {
  display: flex;
  padding: 24rpx;
  gap: 24rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.footer-buttons {
  display: flex;
  gap: 20rpx;
}
