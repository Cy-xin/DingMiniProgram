<view class="app-container">
  <!-- 页面内容区 -->
  <block a:if="{{activeTab === 0}}">
    <import src="../index/index.axml"/>
    <template is="index" data="{{
      categories, 
      filteredProducts, 
      currentCategory, 
      quantities,
      searchText,
      cartTotalQuantity,
      scrollHeight
    }}" />
  </block>

  <block a:if="{{activeTab === 1}}">
    <import src="../cart/cart.axml"/>
    <template is="cart" data="{{
      cartItems,
      totalPrice,
      refreshing
    }}" />
  </block>

  <block a:if="{{activeTab === 2}}">
    <import src="../user/user.axml"/>
    <template is="user" data="{{
      isAuthorized,
      userInfo,
      points,
      credits,
      balance
    }}" />
  </block>

  <!-- 固定的自定义 tabbar -->
  <custom-tabbar 
    activeTab="{{activeTab}}" 
    cartCount="{{cartTotalQuantity}}"
    onTabChange="handleTabChange" 
    onUserClick="handleUserClick"/>
</view>