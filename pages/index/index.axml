<template name="index">
  <view class="page">
    <view class="top-header">
    <view class="location-wrapper">
      <image src="/assets/icons/location.png" class="location-icon" />
        <text class="location-text">配送至：嘉兴市特殊教育学校</text>
      </view>
    <view class="search-bar-wrapper">
      <image src="/assets/icons/search.png" class="search-icon" />
      <input class="search-input" placeholder="搜索当前分类商品，如 矿泉水" onInput="onSearchInput" />
    </view>
  </view>

    <!-- 优化的分类菜单项结构 -->
  <scroll-view scroll-x class="category-tabs-container" scroll-with-animation="{{true}}" show-scrollbar="{{false}}">
    <block a:for="{{categories}}" a:key="id">
      <view class="category-tab-item {{currentCategory.id === item.id ? 'active' : ''}}" onTap="selectCategory" data-id="{{item.id}}">
        <!-- 添加分类图标 -->
        <image class="category-tab-icon" src="{{item.icon || '/assets/icons/default-category.png'}}" a:if="{{item.icon}}" />
        <text>{{item.name}}</text>
        <!-- 添加热门/新品标签 -->
        <view class="category-tab-badge" a:if="{{item.isHot}}">热</view>
        <view class="category-tab-badge" a:elif="{{item.isNew}}" style="background:#409eff;">新</view>
      </view>
    </block>
  </scroll-view>

  <scroll-view scroll-y class="product-scroll" enable-back-to-top="{{true}}">
    <view class="product-list">
      <block a:if="{{filteredProducts.length > 0}}">
        <block a:for="{{filteredProducts}}" a:key="id">
          <view class="product-item">
            <image class="product-image" src="{{item.image}}" mode="aspectFill" onTap="previewImage" data-src="{{item.image}}" />
            <view class="product-info">
              <view>
                <text class="product-name">{{item.name}}</text>
                <text class="product-description">{{item.description || '暂无更多描述'}}</text>
                <view class="product-tags">
                  <text class="tag" a:if="{{item.stock <= 10}}">仅剩{{item.stock}}件</text>
                  </view>
              </view>
              <view class="price-and-action">
                <text class="product-price">¥{{item.price.toFixed(2)}}</text>
                <view class="quantity-control" catchTap="stopPropagation">
                  <block a:if="{{quantities[item.id] > 0}}">
                    <view class="quantity-button decrease" onTap="decreaseQuantity" data-id="{{item.id}}">-</view>
                    <text class="quantity-display">{{quantities[item.id]}}</text>
                  </block>
                  <view class="quantity-button increase" onTap="increaseQuantity" data-id="{{item.id}}">+</view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <!-- 底部占位，防止被 tabbar 挡住 -->
        <view style="height:140rpx"></view>
      </block>
      <view class="empty-state" a:else>
        <image src="/assets/icons/empty.png" class="empty-icon" />
        <text class="empty-text">该分类下暂无商品</text>
      </view>
    </view>
  </scroll-view>

  <view class="float-buttons">
    <view class="float-btn refresh-btn" onTap="handleRefresh">
      <image src="/assets/icons/refresh.png" class="float-icon" mode="aspectFit" />
    </view>
  </view>
</template>