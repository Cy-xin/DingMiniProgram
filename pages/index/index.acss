/* pages/home/index.acss */
.page-container {
  min-height: 100vh;
  background: #f8f9fa;
  display: flex;
  flex-direction: column;
  padding-bottom: 100rpx;
  position: relative;
}

/* 轮播图 */
.banner-swiper {
  width: 92%;
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  margin: 20rpx auto;
  background: #fff;
  position: relative;
  transform: translateZ(0);
  z-index: 2;
}

.banner-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 主体内容 */
.main-wrapper {
  flex: 1;
  display: flex;
  min-height: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
  height: calc(100vh - 340rpx);
}

/* 分类菜单 */
.menu-list {
  width: 200rpx;
  height: 100%;
  overflow-y: auto;
  background: #ffffff;
  padding: 20rpx 0;
  border-right: 1rpx solid #ebeef5;
  border-radius: 16rpx;
  margin: 10rpx;
  box-shadow: 4rpx 0 12rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 3;
  -webkit-overflow-scrolling: touch;
}

.menu-item {
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #606266;
  transition: all 0.3s;
  position: relative;
  display: flex;
  align-items: center;
  line-height: 1.4;
  margin: 0 10rpx;
  border-radius: 12rpx;
  /* 修改以下属性实现自动换行 */
  white-space: normal; /* 允许文本换行 */
  overflow: visible; /* 允许内容溢出显示 */
  text-overflow: clip; /* 移除省略号 */
  min-height: 80rpx; /* 保持最小高度，避免过矮 */
}

.menu-item.active {
  color: #409eff;
  background-color: #ecf5ff;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(64, 158, 255, 0.1);
}

.menu-item::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  background: #c0c4cc;
  border-radius: 50%;
  margin-right: 16rpx;
  transition: all 0.3s;
  flex-shrink: 0;
}

.menu-item.active::before {
  background: #409eff;
  width: 8rpx;
  height: 8rpx;
}

/* 商品列表 */
.product-scroll {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 20rpx;
  height: 100%;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320rpx, 1fr));
  gap: 24rpx;
  padding: 10rpx;
}

.product-item {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: all 0.3s;
}

.product-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.product-image {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  object-fit: cover;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.product-info {
  flex: 1;
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.text-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 28rpx;
  color: #303133;
  line-height: 1.4;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-description {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 0;
}

.product-price {
  color: #f56c6c;
  font-size: 25rpx;
  font-weight: bold;
}

.product-stock {
  font-size: 24rpx;
  color: #f56c6c;
}

.quantity-control {
  display: flex;
  align-items: center;
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 8rpx;
  background: #f5f7fa;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.quantity-button {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  color: #409eff;
  font-weight: bold;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(64, 158, 255, 0.2);
}

.quantity-display {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #303133;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #909399;
}

/* 悬浮按钮组 */
.float-buttons {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 100;
}

.refresh-btn {
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.refresh-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-btn {
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.cart-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #f56c6c;
  color: #fff;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 108, 108, 0.3);
}