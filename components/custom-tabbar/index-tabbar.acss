.tabbar {
  position: fixed;
  bottom: 30rpx;                /* 悬浮效果，距离底部留点空间 */
  left: 20rpx;
  right: 20rpx;
  height: 120rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;

  /* iOS 玻璃效果 */
  background: rgba(255, 255, 255, 0.2);       /* 半透明 */
  backdrop-filter: blur(20rpx);               /* 毛玻璃 */
  -webkit-backdrop-filter: blur(20rpx);

  border-radius: 60rpx;   /* 圆角更大 */
  margin: 0 30rpx 30rpx;  /* 左右收缩一点，悬浮感更强 */
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15); /* 悬浮阴影 */

  border: 1rpx solid rgba(255, 255, 255, 0.3); /* 边框增强玻璃质感 */
}

.tab-item {
  flex: 1;
  text-align: center;
  color: rgba(0, 0, 0, 0.8);
  font-size: 24rpx;
  transition: all 0.3s ease;
  padding: 10rpx;
  border-radius: 20rpx;
  cursor: pointer;

  /* 关键点：让徽标参照当前 tab-item 定位 */
  position: relative;
}

.tab-item:active {
  transform: scale(0.9); /* 点击时有轻微缩放反馈 */
  background: rgba(255, 255, 255, 0.1);
}

.icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
  margin: 0 auto 6rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2)); /* 图标微阴影 */
}

.active {
  color: #4795D5;
  font-weight: bold;
  text-shadow: 0 0 8rpx rgba(255, 255, 255, 0.6); /* 发光效果 */
}

.badge {
  position: absolute;
  top: 0rpx;     /* 根据图标大小可微调 */
  right: 26rpx;  /* 根据购物车图标大小可微调 */
  background: #f56c6c;
  color: #fff;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 32rpx;
  z-index: 10;
}